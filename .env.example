# Provider: claude_code (default, free: your Claude subscription via `claude -p`) | ollama (free, local)
# | anthropic (PAID: billed per token on your API key; only used if you set it here explicitly)
NOVA_PROVIDER=claude_code

# Trusted folders (comma-separated): read/write without asking. The first one is NOVA's workspace
# for relative paths. Any other folder of the computer is accessible after your approval (asked per folder).
NOVA_TRUSTED_DIRS=~/nova-workspace

# Optional
# NOVA_SYSTEM_PROMPT_PATH=src/nova/prompts/system.md
# NOVA_MAX_AGENT_TURNS=10
# NOVA_MAX_READ_BYTES=200000
# NOVA_DISK_SCAN_TIMEOUT_SECONDS=60

# Shell commands: NOVA may run bash commands, each one shown to you and approved first
NOVA_SHELL_ENABLED=true
# NOVA_SHELL_TIMEOUT_SECONDS=120

# Location: filled by `uv run nova setup` (also run automatically at first launch)
NOVA_LOCATION_CITY=
NOVA_LOCATION_REGION=
NOVA_LOCATION_COUNTRY=
NOVA_LOCATION_LATITUDE=
NOVA_LOCATION_LONGITUDE=
NOVA_LOCATION_SOURCE=

# Image generation: free service (pollinations.ai, no key, adds a small logo, sometimes busy)
# NOVA_IMAGE_MODEL=flux

# Web search (DuckDuckGo via ddgs, free, no key)
# NOVA_WEB_REGION=fr-fr

# claude_code: uses your Claude subscription through `claude -p` (run `claude` once to log in)
NOVA_CLAUDE_CODE_CLI=claude
# Empty = CLI default model. Examples: haiku, sonnet, opus
NOVA_CLAUDE_CODE_MODEL=haiku
# NOVA_CLAUDE_CODE_TIMEOUT_SECONDS=300
# Claude accounts: at each launch NOVA asks which account to use (your everyday Claude Code login,
# or accounts added from that menu / with `uv run nova login`, each stored in its own folder here).
# NOVA_CLAUDE_CODE_ACCOUNTS_DIR=~/.nova/claude-accounts
# NOVA_CLAUDE_CODE_SESSIONS_DIR=~/.nova/claude-sessions

# anthropic: Claude API (paid). Ignored unless NOVA_PROVIDER=anthropic
ANTHROPIC_API_KEY=
NOVA_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# NOVA_ANTHROPIC_MAX_TOKENS=4096

# ollama: local model
NOVA_OLLAMA_HOST=http://localhost:11434
NOVA_OLLAMA_MODEL=qwen2.5:7b
# NOVA_OLLAMA_TIMEOUT_SECONDS=300
