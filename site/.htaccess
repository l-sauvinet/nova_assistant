# o2switch (Apache / LiteSpeed): one address per page, HTTPS only, and browser security headers.

RewriteEngine On

# www.nova.sauv-web.fr and http:// both go to https://nova.sauv-web.fr (one address per page for search engines).
RewriteCond %{HTTP_HOST} ^www\. [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://nova.sauv-web.fr%{REQUEST_URI} [L,R=301]

# /index.html and /en/index.html go to / and /en/. THE_REQUEST is the URL the visitor typed, so the
# DirectoryIndex lookup Apache does internally for / cannot loop here.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^ /%1 [L,R=301]

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self'; style-src 'self'; script-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

Options -Indexes

# Accents and dashes must not depend on each tool guessing the encoding.
AddDefaultCharset UTF-8
AddCharset UTF-8 .css .js
